@page "/"
@using SpawnDev.BlazorJS
@using WolfNET.Engine.Graphics

@inject HttpClient Http
@inject IJSRuntime UiRuntime
@inject RendererSettings Settings
@inject GraphicsPreferences GraphicsPreferences

@implements IAsyncDisposable

<PageTitle>Race Imperialis — Pine Loop</PageTitle>

<div class="game-viewport" style="--render-width: @Settings.Width; --render-height: @Settings.Height;">
    <canvas @ref="_canvas" width="@Settings.Width" height="@Settings.Height" tabindex="0" aria-label="Pine Loop racing circuit"></canvas>
</div>

@if (_loading)
{
    <div class="loading-overlay" role="status" aria-live="polite" aria-atomic="true">
        <div class="loading-card">
            <div class="loading-spinner" aria-hidden="true"></div>
            <h1>Loading Pine Loop</h1>
            <p>@_loadingMessage</p>
        </div>
    </div>
}

<aside class="map-switcher" aria-label="Race options">
    <strong>Race Imperialis</strong>
    <p>Pine Loop: race two rivals through the forest circuit, tunnel, and tire-lined bends.</p>
    <div class="race-difficulty">
        <span>Difficulty</span>
        <div class="difficulty-options" role="group" aria-label="Race difficulty">
            <button type="button" disabled="@(_loading || Wolf.Difficulty == RaceDifficulty.Normal)"
                    aria-pressed="@(Wolf.Difficulty == RaceDifficulty.Normal ? "true" : "false")"
                    @onclick="() => SelectDifficultyAsync(RaceDifficulty.Normal)">Normal</button>
            <button type="button" disabled="@(_loading || Wolf.Difficulty == RaceDifficulty.Easy)"
                    aria-pressed="@(Wolf.Difficulty == RaceDifficulty.Easy ? "true" : "false")"
                    @onclick="() => SelectDifficultyAsync(RaceDifficulty.Easy)">Easy</button>
        </div>
        <small>Changing difficulty restarts the race.</small>
    </div>
    <button type="button" class="race-restart" disabled="@_loading" @onclick="RestartRaceAsync">Restart race</button>
    <button type="button" class="graphics-open" disabled="@_loading" aria-haspopup="dialog"
            aria-controls="graphics-menu" @onclick="OpenGraphicsMenu">Graphics settings</button>
</aside>

<dialog @ref="_graphicsDialog" id="graphics-menu" class="graphics-menu" aria-labelledby="graphics-title">
    <EditForm Model="@_graphicsDraft" OnValidSubmit="ApplyGraphicsSettingsAsync" FormName="graphics" novalidate>
        <DataAnnotationsValidator />
        <div class="graphics-heading">
            <div>
                <h1 id="graphics-title">Graphics settings</h1>
                <p>Adjust the view and performance. Your race progress is kept.</p>
            </div>
            <button type="button" class="graphics-close" aria-label="Close graphics settings"
                    disabled="@_applyingGraphics" @onclick="CloseGraphicsMenuAsync">&times;</button>
        </div>
        <fieldset disabled="@_applyingGraphics" class="graphics-fields">
            <legend>Display</legend>
            <div class="graphics-grid">
                <div class="graphics-field">
                    <label for="graphics-width">Width (pixels)</label>
                    <InputNumber id="graphics-width" @bind-Value="_graphicsDraft.Width" min="160" max="7680" />
                </div>
                <div class="graphics-field">
                    <label for="graphics-height">Height (pixels)</label>
                    <InputNumber id="graphics-height" @bind-Value="_graphicsDraft.Height" min="90" max="4320" />
                </div>
                <div class="graphics-field">
                    <label for="graphics-fps">Frame-rate limit (FPS)</label>
                    <InputNumber id="graphics-fps" @bind-Value="_graphicsDraft.TargetFPS" min="15" max="1000" />
                    <small>The display refresh rate also limits FPS.</small>
                </div>
                <div class="graphics-field">
                    <label for="graphics-anisotropy">Anisotropic filtering</label>
                    <InputSelect id="graphics-anisotropy" @bind-Value="_graphicsDraft.MaxAnisotropy">
                        @foreach (var level in Enumerable.Range(1, 16))
                        {
                            <option value="@level">@level×</option>
                        }
                    </InputSelect>
                    <small>Higher values sharpen textures at an angle.</small>
                </div>
            </div>
        </fieldset>
        <fieldset disabled="@_applyingGraphics" class="graphics-fields">
            <legend>View</legend>
            <div class="graphics-grid">
                <div class="graphics-field">
                    <label for="graphics-fov">Horizontal field of view (degrees)</label>
                    <InputNumber id="graphics-fov" @bind-Value="_graphicsDraft.FovDegrees" min="1" max="179" step="any" />
                </div>
                <div class="graphics-field">
                    <label for="column-interlace">Column rendering</label>
                    <InputSelect id="column-interlace" @bind-Value="_graphicsDraft.ColumnInterlaceFactor">
                        <option value="1">Every column</option>
                        <option value="2">Every 2nd column</option>
                        <option value="3">Every 3rd column</option>
                    </InputSelect>
                    <small>Skipped columns keep their previous frame. Fast turns may show trails.</small>
                </div>
                <div class="graphics-field">
                    <label for="graphics-distance">Render distance (map squares)</label>
                    <InputNumber id="graphics-distance" @bind-Value="_graphicsDraft.RenderDistance" min="1" max="1024" step="any" />
                </div>
                <div class="graphics-field">
                    <label for="graphics-fog">Fog starts at (map squares)</label>
                    <InputNumber id="graphics-fog" @bind-Value="_graphicsDraft.FogStartDistance" min="0" max="1023" step="any" />
                    <small>Must be less than the render distance.</small>
                </div>
            </div>
        </fieldset>
        <ValidationSummary class="graphics-validation" role="alert" />
        @if (_graphicsError != null)
        {
            <p class="graphics-validation" role="alert">@_graphicsError</p>
        }
        <div class="graphics-actions">
            <button type="button" disabled="@_applyingGraphics" @onclick="ResetGraphicsDefaults">Reset defaults</button>
            <span></span>
            <button type="button" disabled="@_applyingGraphics" @onclick="CloseGraphicsMenuAsync">Cancel</button>
            <button type="submit" class="graphics-apply" disabled="@_applyingGraphics">@(_applyingGraphics ? "Applying…" : "Apply")</button>
        </div>
        <p class="graphics-save-hint">Settings are saved in this browser. Press Esc to close.</p>
    </EditForm>
</dialog>

<aside class="controls-hint" aria-label="Driving controls">
    <strong>Controls</strong>
    <p>W accelerate &middot; A/D or arrows steer</p>
    <p>S brake/reverse &middot; Space brake &middot; V camera</p>
    <p>Mouse orbits in third person.</p>
    <p role="status">@(_observedMouse?.CaptureError ?? "Click the game to start racing. Esc pauses and releases the mouse.")</p>
</aside>

@if (_error != null)
{
    <pre class="game-error">@_error</pre>
}
